<script client>
const CLOSED = [
    { gate: "Document model", evidence: "format/version/units validation, atomic save" },
    { gate: "Face", evidence: "raster levels and full-width passes" },
    { gate: "Contour", evidence: "closed rectangle offset by the cutter radius" },
    { gate: "Pocket", evidence: "raster stays inside the shrunk boundary" },
    { gate: "Drill", evidence: "G81 cycle and G83 peck with G80 cancel" },
    { gate: "Multi-pass", evidence: "stepdown levels end exactly at depth" },
    { gate: "Reports", evidence: "JSON, CSV and Markdown with cycle time" },
    { gate: "Determinism", evidence: "byte-identical G-code and toolpaths" },
    { gate: "SDK and CLI", evidence: "one session behind both surfaces" },
];

const NEXT = [
    { gate: "3D surfacing", reason: "no mesh or solid input yet" },
    { gate: "Adaptive clearing", reason: "constant-engagement strategies are not built" },
    { gate: "Turning", reason: "the model is prismatic milling only" },
    { gate: "Four-axis", reason: "no rotary axis in the document or post" },
    { gate: "STEP import", reason: "only ASCII 2D DXF import exists, no STEP or solid input" },
    { gate: "Full vendor posts", reason: "only the GRBL, Mach3 and Fanuc subsets are covered" },
];

export default class RoadmapPage {
    public closed: typeof CLOSED = CLOSED;
    public next: typeof NEXT = NEXT;

    static meta() {
        return {
            title: "OpenCAM gate log",
            description:
                "Closed gates with test evidence and the explicitly unimplemented capabilities of OpenCAM.",
        };
    }
}
</script>
