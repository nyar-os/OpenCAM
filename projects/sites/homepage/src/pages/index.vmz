    margin: 0;
    font-family: var(--cam-mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
}

.hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.sheet {
    border: 1px solid var(--cam-line-strong);
    background: var(--cam-surface);
    box-shadow: 6px 6px 0 rgba(16, 23, 28, 0.06);
}

.sheet__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 9px;
    border-bottom: 1px solid var(--cam-line-strong);
    background: var(--cam-surface-2);
    color: var(--cam-muted);
    font-family: var(--cam-mono);
    font-size: 8.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.sheet__no {
    color: var(--cam-ink);
    font-weight: 600;
}

.sheet__rev {
    margin-left: auto;
    padding: 0 5px;
    border: 1px solid var(--cam-line-strong);
    background: var(--cam-surface);
    color: var(--cam-ink);
}

.draw {
    padding: 12px 8px 8px;
    border-bottom: 1px solid var(--cam-line);
    background:
        linear-gradient(to right, rgba(16, 23, 28, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 23, 28, 0.05) 1px, transparent 1px);
    background-size: 12px 12px;
}

.draw__canvas {
    position: relative;
    width: 280px;
    height: 196px;
    margin: 0 auto;
}

.stock {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 240px;
    height: 150px;
    border: 1px solid var(--cam-ink);
    background: rgba(255, 255, 255, 0.55);
}

.raster {
    position: absolute;
    left: 20px;
    width: 240px;
    height: 1px;
    background: var(--cam-accent);
    opacity: 0.75;
}

.hole {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid var(--cam-stop);
    border-radius: 50%;
    background: var(--cam-stop-soft);
}

.dim {
    position: absolute;
    height: 1px;
    background: var(--cam-line-strong);
}

.dim__tick {
    position: absolute;
    width: 1px;
    height: 6px;
    background: var(--cam-line-strong);
}

.dim-label {
    position: absolute;
    left: 108px;
    top: 166px;
    padding: 0 4px;
    background: var(--cam-surface);
    color: var(--cam-muted);
    font-family: var(--cam-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
}

.note {
    position: absolute;
    left: 20px;
    top: 182px;
    color: var(--cam-muted);
    font-family: var(--cam-mono);
    font-size: 8px;
    letter-spacing: 0.05em;
}

.readout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--cam-line);
}

.readout__row {
    display: grid;
    grid-template-columns: 1fr auto 56px;
    align-items: baseline;
    gap: 8px;
    padding: 5px 9px;
    border-right: 1px solid var(--cam-line);
    border-bottom: 1px solid var(--cam-line);
    font-family: var(--cam-mono);
    font-size: 9px;
}

.readout__row:nth-child(2n) {
    border-right: 0;
}

.readout__row:nth-last-child(-n + 2) {
    border-bottom: 0;
}

.readout__row span {
    color: var(--cam-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.readout__row b {
    color: var(--cam-ink);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
}

.readout__row i {
    color: var(--cam-muted);
    font-size: 8px;
    font-style: normal;
    text-align: right;
}

.readout__row--ok b {
    color: var(--cam-ok);
}

.sheet__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 4px 9px;
    background: var(--cam-surface-2);
    color: var(--cam-muted);
    font-family: var(--cam-mono);
    font-size: 8px;
    letter-spacing: 0.03em;
}

.method {
    color: var(--cam-muted);
    font-family: var(--cam-mono);
    font-size: 11px;
}

.flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--cam-line-strong);
    background: var(--cam-surface);
}

.flow-step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    padding: 16px 14px;
    border-right: 1px solid var(--cam-line);
}

.flow-step:last-child {
    border-right: 0;
}

.flow-index {
    color: var(--cam-accent-ink);
    font-family: var(--cam-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
}

.flow-step h3 {
    margin: 0;
    font-size: 14px;
}

.flow-step p {
    flex: 1;
    margin: 0 0 6px;
    color: var(--cam-muted);
    font-size: 12.5px;
}

.scope-card {
    padding-top: 16px;
}

.scope-card--in {
    border-top-color: var(--cam-ok);
}

.scope-card--out {
    border-top-color: var(--cam-stop);
}

.scope-card ul {
    margin-top: 8px;
    padding-left: 18px;
}

.scope-card li {
    margin: 4px 0;
    font-size: 13px;
}

.status-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 36px;
    padding: 18px 20px;
    border: 1px solid var(--cam-line-strong);
    border-left: 4px solid var(--cam-accent);
    background: var(--cam-surface);
}

.status-band h2 {
    margin: 6px 0 6px;
    font-size: 19px;
}

.status-band p {
    max-width: 720px;
    margin: 0;
    color: var(--cam-muted);
    font-size: 13.5px;
}

@media (max-width: 980px) {
    .hero {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .sheet {
        max-width: 460px;
    }

    .flow {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .flow-step:nth-child(2) {
        border-right: 0;
    }

    .flow-step:nth-child(-n + 2) {
        border-bottom: 1px solid var(--cam-line);
    }
}

@media (max-width: 620px) {
    .hero h1 {
        font-size: 27px;
    }

    .spec__row {
        grid-template-columns: 1fr;
        gap: 1px;
    }

    .flow {
        grid-template-columns: 1fr;
    }

    .flow-step {
        border-right: 0;
        border-bottom: 1px solid var(--cam-line);
    }

    .flow-step:last-child {
        border-bottom: 0;
    }
}
</style>

<script client>
const CAPABILITY_ROWS = [
    { code: "FACE", capability: "Raster facing", method: "zig-zag over the stock top", status: "available" },
    { code: "CONTOUR", capability: "Outside profile", method: "rectangle offset by cutter radius", status: "available" },
    { code: "POCKET", capability: "Rectangular pocket", method: "raster inside the shrunk boundary", status: "available" },
    { code: "DRILL", capability: "Drilling", method: "G81 cycle, G83 with peck", status: "available" },
    { code: "PASS", capability: "Multi-pass depth", method: "stepdown levels ending at depth", status: "available" },
    { code: "REPORT", capability: "Toolpath report", method: "moves, lengths, cycle time", status: "available" },
    { code: "POST", capability: "Generic mill post", method: "G21 G90 G17 G94 absolute", status: "available" },
    { code: "SURF", capability: "3D surfacing", method: "not implemented", status: "blocked" },
    { code: "ADAPT", capability: "Adaptive clearing", method: "not implemented", status: "blocked" },
    { code: "TURN", capability: "Turning", method: "not implemented", status: "blocked" },
    { code: "AXIS4", capability: "Four-axis work", method: "not implemented", status: "blocked" },
    { code: "STEP", capability: "STEP / DXF import", method: "not implemented", status: "blocked" },
];

export default class IndexPage {
    public capabilityRows: typeof CAPABILITY_ROWS = CAPABILITY_ROWS;
    public rasterRows = [44, 62, 80, 98, 116, 134, 152];
    public moves = "184";
    public cutLength = "12 480";
    public cycleTime = "742.6";

    static meta() {
        return {
            title: "OpenCAM - deterministic 2.5-axis toolpaths and G-code",
            description:
                "OpenCAM keeps one .ocam document for facing, contouring, pocketing and drilling, with deterministic toolpaths, G-code and machine-readable reports.",
        };
    }

    statusChip(status: string) {
        if (status === "available") return "chip chip--available";
        if (status === "limited") return "chip chip--limited";
        return "chip chip--blocked";
    }
}
</script>
