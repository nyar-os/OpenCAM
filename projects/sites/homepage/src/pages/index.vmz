    margin: 0 0 24px;
    border-top: 1px solid var(--cam-line);
}

.spec__row {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px solid var(--cam-line);
}

.spec dt {
    color: var(--cam-muted);
    font-family: var(--cam-mono);
