{
    "name": "@wae/open-cam",
    "version": "0.0.0",
    "private": true,
    "description": "Deterministic 2.5-axis toolpaths and G-code on one native model",
    "license": "MPL-2.0",
    "type": "module",
    "engines": {
        "node": ">=22.6"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "open-cam": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/smoke.test.js"
    },
    "keywords": [
        "cam",
        "gcode",
        "milling",
        "toolpath",
        "wae"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-os/OpenCAM.git",
        "directory": "projects/packages/open-cam"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    },
    "optionalDependencies": {
        "@wae/open-cam-darwin-arm64": "workspace:*",
        "@wae/open-cam-darwin-x64": "workspace:*",
        "@wae/open-cam-linux-arm64": "workspace:*",
        "@wae/open-cam-linux-x64": "workspace:*",
        "@wae/open-cam-win32-x64": "workspace:*"
    }
}
